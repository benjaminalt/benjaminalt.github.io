---
interface Props { page: number; total: number }
const { page, total } = Astro.props;
const href = (n: number) => (n === 1 ? '/blog/' : `/blog/page/${n}/`);
---

{
  total > 1 && (
    <nav class="pager mono" aria-label="Pagination">
      {page > 1 ? <a rel="prev" href={href(page - 1)}>← newer</a> : <span />}
      <span class="count">{page} / {total}</span>
      {page < total ? <a rel="next" href={href(page + 1)}>older →</a> : <span />}
    </nav>
  )
}

<style>
  .pager {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-block-start: 2.5rem;
    padding-block-start: 1.25rem;
    border-block-start: 1px solid var(--rule);
    font-size: var(--step--1);
  }
  .pager a { text-decoration: none; color: var(--muted); }
  .pager a:hover { color: var(--accent); }
  .count { color: var(--muted); }
</style>
