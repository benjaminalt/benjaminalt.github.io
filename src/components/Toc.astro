---
import type { MarkdownHeading } from 'astro';

interface Props { headings: MarkdownHeading[] }
const { headings } = Astro.props;
/* h1 in the body is the post's own section heading level in this content, so
   include depth 1-2 and indent 3. */
const items = headings.filter((h) => h.depth <= 3);
---

{
  items.length > 2 && (
    <nav class="toc" aria-labelledby="toc-heading">
      <p class="label" id="toc-heading">Contents</p>
      <ol>
        {items.map((h) => (
          <li class:list={[`d${h.depth}`]}>
            <a href={`#${h.slug}`}>{h.text}</a>
          </li>
        ))}
      </ol>
    </nav>
  )
}

<style>
  .toc {
    max-width: var(--measure);
    margin-inline: auto;
    margin-block-end: 2.5rem;
    padding: 1.1rem 1.25rem;
    border: 1px solid var(--rule);
    border-radius: var(--radius);
  }
  .toc ol {
    list-style: none;
    padding: 0;
    margin: 0.6rem 0 0;
    font-size: var(--step--1);
  }
  .toc li + li { margin-block-start: 0.3rem; }
  .toc .d3 { padding-inline-start: 1.1rem; }
  .toc a { color: var(--muted); text-decoration: none; }
  .toc a:hover { color: var(--accent); }
</style>
