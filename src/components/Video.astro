---
/* Facade player: no YouTube iframe (and no YouTube cookies) until clicked. */
interface Props { id: string; title?: string; caption?: string }
const { id, title = 'Video', caption } = Astro.props;
const thumb = `https://i.ytimg.com/vi/${id}/hqdefault.jpg`;
---

<figure class="video">
  <div class="frame" data-video={id} data-title={title}>
    <button type="button" aria-label={`Play: ${title}`}>
      <img src={thumb} alt="" loading="lazy" width="480" height="360" />
      <span class="play" aria-hidden="true"></span>
    </button>
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .video { margin-block: 2rem; max-width: min(100%, calc(var(--measure) + var(--figure-bleed, 0px))); }
  .frame {
    position: relative;
    aspect-ratio: 16 / 9;
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .frame button {
    all: unset;
    display: block;
    cursor: pointer;
    width: 100%;
    height: 100%;
  }
  .frame img { width: 100%; height: 100%; object-fit: cover; }
  .frame :global(iframe) { width: 100%; height: 100%; border: 0; display: block; }
  .play {
    position: absolute;
    inset: 50% auto auto 50%;
    translate: -50% -50%;
    width: 3.6rem;
    height: 3.6rem;
    border-radius: 50%;
    background: var(--bg);
    border: 1px solid var(--rule);
  }
  .play::after {
    content: '';
    position: absolute;
    inset: 50% auto auto 54%;
    translate: -50% -50%;
    border-inline-start: 0.85rem solid var(--accent);
    border-block: 0.55rem solid transparent;
  }
  .frame button:hover .play { border-color: var(--accent); }
  figcaption {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--muted);
    margin-block-start: 0.65rem;
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('.frame[data-video]').forEach((frame) => {
    frame.querySelector('button')?.addEventListener('click', () => {
      const id = frame.dataset.video;
      const iframe = document.createElement('iframe');
      iframe.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1`;
      iframe.title = frame.dataset.title ?? 'Video';
      iframe.allow = 'accelerometer; autoplay; encrypted-media; picture-in-picture';
      iframe.allowFullscreen = true;
      frame.replaceChildren(iframe);
    });
  });
</script>
