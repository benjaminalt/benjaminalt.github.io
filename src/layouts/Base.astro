---
import '@fontsource-variable/source-serif-4';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '../styles/tokens.css';
import '../styles/base.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../consts';

interface Props {
  title?: string;
  description?: string;
  /** Full-bleed pages opt out of the default prose container */
  bare?: boolean;
  ogType?: 'website' | 'article';
  publishedTime?: Date;
}

const {
  title,
  description = SITE.description,
  bare = false,
  ogType = 'website',
  publishedTime,
} = Astro.props;

const pageTitle = title ? `${title} · ${SITE.title}` : SITE.title;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/assets/img/portrait.jpg', Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href="/feed.xml" />

    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />

    {/* Set the theme before first paint so there is no flash. */}
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('theme');
          if (t === 'light' || t === 'dark') {
            document.documentElement.setAttribute('data-theme', t);
          }
        } catch (e) {
          /* private mode, blocked storage — fall through to system preference */
        }
      })();
    </script>

    <slot name="head" />
  </head>

  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header />
    <main id="main" data-pagefind-body>
      {bare ? <slot /> : <div class="container measure flow"><slot /></div>}
    </main>
    <Footer />

    <style>
      .skip {
        position: absolute;
        left: -9999px;
        top: 0;
        background: var(--bg);
        color: var(--text);
        padding: 0.6rem 1rem;
        border: 1px solid var(--rule);
        z-index: 100;
      }
      .skip:focus {
        left: var(--gutter);
        top: 0.5rem;
      }
      body {
        display: flex;
        flex-direction: column;
        min-height: 100vh;
      }
      main {
        flex: 1;
        padding-block: clamp(2.5rem, 1.8rem + 3.5vw, 5rem);
      }
    </style>
  </body>
</html>
