---
import Base from '../../layouts/Base.astro';
import NewsRow from '../../components/NewsRow.astro';
import { allNews } from '../../lib/content';

const news = await allNews();
---

<Base title="News" description="Talks, papers and announcements.">
  <header class="head">
    <h1>News</h1>
    <p class="sub">Talks, papers and announcements.</p>
  </header>
  <ul class="list">{news.map((item) => <NewsRow item={item} />)}</ul>
</Base>

<style>
  .head { margin-block-end: 2rem; }
  .sub { color: var(--muted); margin-block-start: 0.6rem; font-size: var(--step-1); }
  .list { list-style: none; padding: 0; margin: 0; max-width: var(--measure); }
</style>
