---
import PostRow from './PostRow.astro';
import type { Post } from '../lib/content';

interface Props { posts: Post[]; empty?: string }
const { posts, empty = 'Nothing here yet.' } = Astro.props;
---

{
  posts.length === 0 ? (
    <p class="empty">{empty}</p>
  ) : (
    <div class="list">{posts.map((post) => <PostRow post={post} showDescription />)}</div>
  )
}

<style>
  .list { max-width: var(--measure); }
  .empty { color: var(--muted); }
</style>
