---
import { SOCIAL, SITE } from '../consts';
import MailLink from './MailLink.astro';
const year = new Date().getFullYear();
---

<footer data-pagefind-ignore>
  <div class="container inner">
    <div class="links">
      <a href={SOCIAL.github} target="_blank" rel="me noopener">GitHub</a>
      <a href={SOCIAL.linkedin} target="_blank" rel="me noopener">LinkedIn</a>
      <a href={SOCIAL.scholar} target="_blank" rel="me noopener">Scholar</a>
      <a href={SOCIAL.orcid} target="_blank" rel="me noopener">ORCID</a>
      <a href="/feed.xml">RSS</a>
      <MailLink>Email</MailLink>
    </div>
    <p class="mono meta">© {year} {SITE.title}</p>
  </div>
</footer>

<style>
  footer {
    border-block-start: 1px solid var(--rule);
    padding-block: 2rem 2.5rem;
    margin-block-start: 4rem;
  }
  .inner {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .links {
    display: flex;
    gap: clamp(0.8rem, 0.5rem + 1vw, 1.4rem);
    flex-wrap: wrap;
  }
  .links :global(a) {
    font-size: var(--step--1);
    color: var(--muted);
    text-decoration: none;
  }
  .links :global(a:hover) { color: var(--accent); }
  .meta {
    font-size: var(--step--1);
    color: var(--muted);
    margin: 0;
  }
</style>
