---
import type { MarkdownHeading } from 'astro';

interface Props { headings: MarkdownHeading[] }
const { headings } = Astro.props;

const items = headings.filter((h) => h.depth <= 3);
/* Posts disagree about where their top level sits: some open at h1, others at
   h2. Indent by distance from the shallowest heading actually present rather
   than by absolute depth, so nesting reads correctly in either convention. */
const top = items.length > 0 ? Math.min(...items.map((h) => h.depth)) : 1;
---

{
  items.length > 2 && (
    <nav class="toc" aria-labelledby="toc-heading">
      <p class="label" id="toc-heading">Contents</p>
      <ol>
        {items.map((h) => (
          <li class:list={[`lvl${h.depth - top}`]}>
            <a href={`#${h.slug}`}>{h.text}</a>
          </li>
        ))}
      </ol>
    </nav>
  )
}

<style>
  .toc {
    max-width: var(--measure);
    margin-inline: auto;
    margin-block-end: 2.5rem;
    padding: 1.1rem 1.25rem;
    border: 1px solid var(--rule);
    border-radius: var(--radius);
  }
  .toc ol {
    list-style: none;
    padding: 0;
    margin: 0.6rem 0 0;
    font-size: var(--step--1);
  }
  .toc li + li { margin-block-start: 0.3rem; }

  /* Indentation alone is far too thin a signal at this type size, so the
     hierarchy leans on three things at once: a wider indent step, weight and
     colour on the top level, and air before each new top-level section. */
  .toc .lvl1 { padding-inline-start: 1.5rem; }
  .toc .lvl2 { padding-inline-start: 3rem; }
  .toc li + li.lvl0 { margin-block-start: 0.9rem; }
  .toc .lvl0 > a { color: var(--text); font-weight: 600; }
  .toc a { color: var(--muted); text-decoration: none; }
  .toc a:hover { color: var(--accent); }
</style>
