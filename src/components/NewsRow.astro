---
import type { NewsItem } from '../lib/content';
import { newsUrl, shortDate } from '../lib/content';

interface Props { item: NewsItem; compact?: boolean }
const { item, compact = false } = Astro.props;
---

<li class:list={['item', { compact }]}>
  <time class="mono when" datetime={item.data.date.toISOString().slice(0, 10)}>
    {shortDate(item.data.date)}
  </time>
  <a href={newsUrl(item)}>{item.data.title}</a>
</li>

<style>
  .item {
    display: grid;
    grid-template-columns: 5.5rem 1fr;
    gap: 0.25rem 1rem;
    padding-block: 0.7rem;
    border-block-end: 1px solid var(--rule);
    align-items: baseline;
  }
  .when {
    font-size: var(--step--1);
    color: var(--muted);
    white-space: nowrap;
  }
  .item a {
    text-decoration: none;
    line-height: 1.4;
    text-wrap: pretty;
  }
  .item a:hover { color: var(--accent); }
  /* The sidebar is far narrower than the viewport, so it stacks regardless. */
  .item.compact {
    grid-template-columns: 1fr;
    gap: 0.15rem;
    padding-block: 0.6rem;
  }
  .item.compact a { font-size: var(--step--1); line-height: 1.45; }
  @media (max-width: 34rem) {
    .item { grid-template-columns: 1fr; }
  }
</style>
